# =============================================
# PEDAGOGY BACKEND ENVIRONMENT CONFIGURATION
# =============================================
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=postgresql+asyncpg://pedagogy:pedagogy_secret@localhost:5432/pedagogy

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
DEBUG=True

# CORS Origins (comma-separated in .env, but configured as list in code)
# These are configured in app/config.py
