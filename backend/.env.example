# =============================================
# PEDAGOGY BACKEND ENVIRONMENT CONFIGURATION
# =============================================
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=postgresql+asyncpg://pedagogy:pedagogy_secret@localhost:5432/pedagogy

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
DEBUG=True

# CORS Origins (comma-separated in .env, but configured as list in code)
# These are configured in app/config.py

# =============================================
# LLM PROVIDER CONFIGURATION
# =============================================
# Provider options: "gemini" (recommended), "ollama" (local), "openai" (paid)
LLM_PROVIDER=gemini

# Google Gemini (Primary - FREE tier available!)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.3

# Ollama (Fallback - Local/Offline)
# Install from: https://ollama.ai then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (Alternative - Paid)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4.1
